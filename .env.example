# Copy to .env.local and fill in.

# Neon Postgres connection string (pooled connection is fine — the
# @neondatabase/serverless HTTP driver doesn't hold a persistent socket).
DATABASE_URL="postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/webohra?sslmode=require"

# HS256 signing secret for session + phone-verification JWTs (lib/auth.ts).
# Generate your own, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="replace-with-a-random-32-byte-secret"

# "dev" logs OTP codes to the server console and echoes them back in the API
# response, for testing without SMS cost. Set to "msg91" once a real MSG91
# provider is implemented in lib/otp/provider.ts.
OTP_PROVIDER=dev

# Cloudflare R2 (S3-compatible) — product photo storage, see lib/storage/r2.ts.
# Create in the Cloudflare dashboard: R2 > Create bucket, then
# R2 > Manage API tokens > Create API token (permissions: Object Read & Write,
# scoped to that bucket). R2_ACCOUNT_ID is in the dashboard URL/sidebar.
# R2_PUBLIC_BASE_URL is the bucket's public access URL (enable it under the
# bucket's Settings > Public access, or point it at a custom domain) —
# without a trailing slash.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Razorpay — checkout, refunds, wallet top-ups (lib/razorpay.ts). Key ID/
# Secret from Dashboard > Settings > API Keys; the client-side widget gets
# the key_id server-side via each order-creation response, never a
# NEXT_PUBLIC_ var. Webhook Secret is set when you register the webhook
# URL (Settings > Webhooks) — needs order.paid, payment.failed,
# refund.processed, refund.failed enabled.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# RazorpayX Payouts' real money-moving call (lib/razorpay-payouts.ts'
# createPayout) — not used by the live product anymore (seller payouts
# are Admin-paid manually now, see the phase-plan memory for why); only
# needed if that feature is ever revisited. Safe to leave unset.
RAZORPAYX_ACCOUNT_NUMBER=""
